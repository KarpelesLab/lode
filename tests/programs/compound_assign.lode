// exit: 0
package main

struct Acc {
	bits: u8
	sum: u32
	hist: [4]u16
}

// Every binary operator has its `op=` form, with the binary operator's proof
// rules.
fn bump(inout n: u32, inout flags: u8) {
	n +%= 1
	n *|= 2
	flags |= 0x80
}

fn main() -> u8 {
	var a: u32 = 0xffff_fff0
	a +%= 0x20
	if a != 0x10 {
		return 1
	}
	a -%= 0x11
	if a != 0xffff_ffff {
		return 2
	}
	a *%= 2
	if a != 0xffff_fffe {
		return 3
	}
	a +|= 5
	if a != 0xffff_ffff {
		return 4
	}
	a -|= 0xffff_fff0
	a -|= 0x20
	if a != 0 {
		return 5
	}
	var m: u32 = 0x1000_0000
	m *|= 0x10
	if m != 0xffff_ffff {
		return 6
	}
	var b: u8 = 0b1100
	b |= 0b0011
	b &= 0b0110
	b ^= 0b1111
	if b != 0b1001 {
		return 7
	}
	b <<%= 9
	if b != 0b0001_0010 {
		return 8
	}
	var s: i8 = -100
	s -|= 100
	if s != -128 {
		return 9
	}
	s +|= 127
	s +|= 127
	if s != 126 {
		return 10
	}

	var acc = Acc{bits: 1, sum: 4_000_000_000, hist: [0, 1, 2, 65535]}
	acc.bits |= 6
	acc.sum +|= 4_000_000_000
	acc.hist[3] +%= 2
	acc.hist[1] ^= 3
	for i in 0..acc.hist.len {
		acc.hist[i] *|= 1000
	}
	if acc.bits != 7 || acc.sum != 0xffff_ffff || acc.hist != [0, 2000, 2000, 1000] {
		return 11
	}

	var n: u32 = 5
	var flags: u8 = 1
	bump(&n, &flags)
	if n != 12 || flags != 0x81 {
		return 12
	}
	return 0
}
