// error: cannot prove that this addition does not overflow `u64`
// error: cannot prove that this multiplication does not overflow `i64`
// error: cannot prove that this addition does not overflow `u32`
// error: cannot prove that this is not `-9223372036854775808` divided by -1
// error: cannot prove that this divisor is not zero
// error: cannot prove that this divisor is not zero
// error: cannot prove that this subtraction does not overflow `usize`
// error: cannot prove that this subtraction does not overflow `usize`
// error: cannot prove that this index is less than the length
// error: cannot prove that this subtraction does not overflow `usize`
package main

// Dividing by 1 keeps the whole range.
fn div_one(x: u64) -> u64 {
	let d = x / 1
	return d + 1
}

// Half the range, tripled, doesn't fit.
fn triple_half(x: i64) -> i64 {
	return (x / 2) * 3
}

// `|` with an operand that can have the top bit set can be the largest
// `u32`.
fn or_top(x: u32) -> u32 {
	let v = x | 1
	return v + 1
}

// `&&` being false gives no fact: either side may be the one that's false.
fn guarded_pair(a: i64, b: i64) -> i64 {
	if b == 0 {
		return 0
	}
	if a == -9223372036854775808 && b == -1 {
		return 0
	}
	return a / b
}

// A hole moves with `b = b + 1`: now `b` isn't 1, but it can be 0.
fn moved_hole(a: i32, b: i32) -> i32 {
	if b <= -100 || b >= 100 {
		return 0
	}
	var c = b
	if c == 0 {
		return 0
	}
	c = c + 1
	return a / c
}

// A hole only holds at the head of a loop if every iteration keeps it.
fn reset_in_loop(xs: []i32, d0: i32) -> i32 {
	if d0 == 0 {
		return 0
	}
	var d = d0
	var total: i32 = 0
	for x in xs {
		total = total +% 100 / d
		d = x
	}
	return total
}

// Growing by 2 per iteration, the counter can pass the length.
fn count_twice(xs: []u8) -> usize {
	var n: usize = 0
	for x in xs {
		if x == 0 {
			n = n +| 2
		}
	}
	return xs.len - n
}

// Only `i - start <= 1` holds, and the copy can pass `i`.
fn ahead(src: []u8, pos: usize) -> usize {
	var i = pos
	var start = pos
	while i < src.len {
		if src[i] == ' ' {
			start = i + 2
		}
		i = i + 1
	}
	return i - start
}

// Rising under `sp <= 4` lets `sp` reach 5: the threshold 4 isn't kept,
// and `stack[sp - 1]` can't be proven.
fn off_by_one(prog: []u8) -> i64 {
	var stack: [4]i64 = [0; 4]
	var sp: usize = 0
	for op in prog {
		if op < 100 {
			if sp <= 4 {
				sp = sp + 1
			}
		} else if sp > 0 {
			sp = sp - 1
		}
		if sp > 0 {
			stack[sp - 1] = 1
		}
	}
	return 0
}

fn bump(inout n: usize) {
	n = n +% 2
}

// A counter changed through `&n` is assigned by the loop like any other:
// after the call, nothing relates it to the index.
fn counted_by_call(xs: []u8) -> usize {
	var n: usize = 0
	for x in xs {
		if x == 0 {
			bump(&n)
		}
	}
	return xs.len - n
}

fn main() {
}
