fn mul_u64(a: u64, b: u64) -> u64 {
	return a *| b
}

fn check_u64() -> bool {
	let vs: [7]u64 = [0, 1, 2, 18446744073709551615, 4294967295, 4294967296, 3]
	let want: [49]u64 = [
		0, 0, 0, 0, 0, 0, 0,
		0, 1, 2, 18446744073709551615, 4294967295, 4294967296, 3,
		0, 2, 4, 18446744073709551615, 8589934590, 8589934592, 6,
		0, 18446744073709551615, 18446744073709551615, 18446744073709551615, 18446744073709551615, 18446744073709551615, 18446744073709551615,
		0, 4294967295, 8589934590, 18446744073709551615, 18446744065119617025, 18446744069414584320, 12884901885,
		0, 4294967296, 8589934592, 18446744073709551615, 18446744069414584320, 18446744073709551615, 12884901888,
		0, 3, 6, 18446744073709551615, 12884901885, 12884901888, 9,
	]
	for i in 0..7 {
		for j in 0..7 {
			if mul_u64(vs[i], vs[j]) != want[i * 7 + j] {
				return false
			}
		}
	}
	return true
}

fn main() -> u8 {
	if !check_i8() {
		return 1
	}
	if !check_u8() {
		return 2
	}
	if !check_i16() {
		return 3
	}
	if !check_u16() {
		return 4
	}
	if !check_i32() {
		return 5
	}
	if !check_u32() {
		return 6
	}
	if !check_i64() {
		return 7
	}
	if !check_u64() {
		return 8
	}
	return 0
}
