// error: cannot prove that this subtraction does not overflow `usize`
package main

// Counting up by 2 past the bound: `i` can reach 10.
fn up_by_two() {
	var buf: [10]u8 = [0; 10]
	var i: usize = 0
	while i < 9 {
		buf[i + 1] = 1
		i = i + 2
	}
	buf[i] = 2
}

// `i <= buf.len` holds at the end of the body, but not at the `continue`.
fn continue_breaks_it(n: u32) {
	var buf: [8]u8 = [0; 8]
	var i = buf.len
	var k: u32 = 0
	while i > 0 {
		k = k +% 1
		if k == n {
			i = 9
			continue
		}
		i = i - 1
		buf[i] = 1
	}
}

// After a `loop`, only the facts at its `break`s hold.
fn loop_exit(n: usize) {
	var buf: [4]u8 = [0; 4]
	var i: usize = 0
	loop {
		if i >= n {
			break
		}
		i = i + 1
	}
	buf[i] = 0
}

// The inner loop leaves `j` at 5.
fn nested() {
	var buf: [4]u8 = [0; 4]
	var j: usize = 0
	for k in 0..3 {
		j = 0
		while j < 5 {
			j = j + 1
		}
		buf[j] = 1
	}
}

// Counting down by 2 from an odd start: `i > 0` doesn't make `i - 2` safe.
fn down_by_two() {
	var i: usize = 7
	while i > 0 {
		i = i - 2
	}
}

// A loop of height 5 doesn't search for its head: it forgets what it
// knew about `i`, and `buf[i]` can't be proven (with one loop less, it is).
fn too_high() {
	var buf: [8]u8 = [0; 8]
	var i = buf.len
	while i > 0 {
		i = i - 1
		buf[i] = 1
		for a in 0..2 {
			for b in 0..2 {
				for d in 0..2 {
					for e in 0..2 {
					}
				}
			}
		}
	}
}

