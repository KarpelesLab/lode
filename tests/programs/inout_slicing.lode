// stdout: 9 1 2 3 4 5 0 \n
// stdout: -9 -4 0 1 2 3 5 7 8 12 \n
// exit: 0
package main

import "std/io"

fn print_all(xs: []i32) {
	for x in xs {
		io.print_i64(x)
		io.print(" ")
	}
	io.print("\n")
}

// Insertion sort, in place.
fn insertion_sort(inout xs: []i32) {
	for i in 1..xs.len {
		let key = xs[i]
		var j = i
		while j > 0 && xs[j - 1] > key {
			xs[j] = xs[j - 1]
			j = j - 1
		}
		xs[j] = key
	}
}

// Quicksort: partition around the last element, then sort each side, a
// sub-slice passed `inout`.
fn quicksort(inout xs: []i32) {
	if xs.len <= 1 {
		return
	}
	let last = xs.len - 1
	let pivot = xs[last]
	var store: usize = 0
	for i in 0..xs.len - 1 {
		if xs[i] < pivot {
			let t = xs[i]
			xs[i] = xs[store]
			xs[store] = t
			store = store + 1
		}
	}
	xs[last] = xs[store]
	xs[store] = pivot
	quicksort(&xs[..store])
	quicksort(&xs[store + 1..])
}

// Fill a sub-range of a slice.
fn fill(inout xs: []i32, v: i32) {
	for i in 0..xs.len {
		xs[i] = v
	}
}

fn main() -> u8 {
	// Sort only the middle of an array.
	var a: [7]i32 = [9, 5, 3, 1, 4, 2, 0]
	insertion_sort(&a[1..6])
	print_all(a)
	var b: [10]i32 = [5, -4, 12, 0, 8, -9, 3, 1, 7, 2]
	quicksort(&b)
	print_all(b)
	// A sub-range of a sub-range.
	var c: [6]i32 = [0, 0, 0, 0, 0, 0]
	fill(&c[1..5], 1)
	fill(&c[1..5][1..3], 2)
	if c != [0, 1, 2, 2, 1, 0] {
		return 1
	}
	// An element of a 2D array, sliced.
	var grid: [2][4]i32 = [[0; 4]; 2]
	fill(&grid[1][2..], 7)
	if grid[1] != [0, 0, 7, 7] || grid[0] != [0, 0, 0, 0] {
		return 2
	}
	return 0
}
