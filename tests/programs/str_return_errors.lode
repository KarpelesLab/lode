// error: a function can only return a `str` that is a string literal
// error: a function can only return a `str` that is a string literal
// error: a function can only return a `str` that is a string literal
// error: a function that throws can't return a `str` yet
// error: returning a slice is not supported by the compiler yet
// help: a returned `str` can't borrow from the parameters yet
package main

enum E {
	bad
}

// A parameter's string may borrow from the caller's storage: it can't be
// returned until the compiler checks the view rules.
fn same(s: str) -> str {
	return s
}

// Nor a local that held one at any point.
fn pick(s: str, b: bool) -> str {
	var out = "default"
	if b {
		out = s
	}
	return out
}

// Copies of such a local are tainted too.
fn copied(s: str) -> str {
	var a = "x"
	let b = a
	a = s
	let c = b
	if c.len > 0 {
		return a
	}
	return "y"
}

fn thrown() throws(E) -> str {
	return "x"
}

fn slice(xs: []u8) -> []u8 {
	return xs
}

fn main() -> u8 {
	return 0
}
