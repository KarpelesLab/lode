// stdin: hello\n
// stdin: a second line, without a newline at the end
// stdout: hello\n
// stdout: a second line, without a newline at the end
package main

import "std/io"

// `cat`: standard input to standard output, a buffer at a time.
fn main() -> u8 {
	var buf: [4096]u8 = [0; 4096]
	loop {
		let n = io.stdin().read(&buf) catch _ {
			return 1
		}
		if n == 0 {
			return 0
		}
		// `read` never returns more than `buf.len`, but the checker doesn't
		// know what a call returns yet.
		if n > buf.len {
			return 3
		}
		io.stdout().write_bytes(buf[..n]) catch _ {
			return 2
		}
	}
}
