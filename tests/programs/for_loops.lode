// exit: 0
package main

fn sum(xs: []u32) -> u32 {
	var total: u32 = 0
	for x in xs {
		total = total +% x
	}
	return total
}

// The loop variable's range comes from the bounds: `i < 10` here, so
// `i * i` fits in a `u8`.
fn squares() -> u32 {
	var total: u32 = 0
	for i in 0..10 {
		total = total +% u32(u8(i) * u8(i))
	}
	return total
}

// Typed and signed bounds; the bounds are evaluated once.
fn signed_range() -> i32 {
	var total: i32 = 0
	var end: i32 = 3
	for i in -3..end {
		end = 100
		total = total +% i
	}
	return total
}

// An empty range runs nothing.
fn empty(n: u8) -> u32 {
	var count: u32 = 0
	for i in n..n {
		count = count +% 1
	}
	return count
}

// `break` and `continue` in a `for` loop.
fn odd_sum_below(limit: u32, xs: []u32) -> u32 {
	var total: u32 = 0
	for i in 0..xs.len {
		if xs[i] >= limit {
			break
		}
		if xs[i] % 2 == 0 {
			continue
		}
		total = total +% xs[i]
	}
	return total
}

// Nested loops over nested arrays.
fn grid_sum() -> u32 {
	var g: [3][4]u8 = [[0; 4]; 3]
	for r in 0..3 {
		for c in 0..g[r].len {
			g[r][c] = u8(r * 4 + c)
		}
	}
	var total: u32 = 0
	for row in g {
		for cell in row {
			total = total +% u32(cell)
		}
	}
	return total
}

// `for x in a` goes over the array as it was when the loop started.
fn snapshot() -> u32 {
	var a: [3]u32 = [1, 2, 3]
	var total: u32 = 0
	for x in a {
		a[2] = 100
		total = total +% x
	}
	return total +% a[2]
}

// The loop variable is related to the bounds: here `1 <= i < xs.len`, so
// `xs[i - 1]` is proven.
fn rises(xs: []u8) -> u32 {
	var n: u32 = 0
	for i in 1..xs.len {
		if xs[i - 1] < xs[i] {
			n = n +% 1
		}
	}
	return n
}

// Over an empty array, the body never runs.
fn over_nothing() -> u32 {
	let empty: [0]u8 = []
	var n: u32 = 0
	for x in empty {
		n = n +% u32(x)
	}
	return n
}

// Long enough that the copy of `big` (which the body assigns) is a loop.
fn long_snapshot() -> u32 {
	var big: [40]u16 = [3; 40]
	var total: u32 = 0
	for x in big {
		big[39] = 0
		total = total +% u32(x)
	}
	return total
}

fn main() -> u8 {
	let a: [5]u32 = [1, 2, 3, 4, 5]
	if sum(a) != 15 {
		return 1
	}
	if squares() != 285 {
		return 2
	}
	if signed_range() != -3 {
		return 3
	}
	if empty(7) != 0 {
		return 4
	}
	let xs: [6]u32 = [1, 3, 4, 5, 9, 7]
	if odd_sum_below(9, xs) != 9 {
		return 5
	}
	if grid_sum() != 66 {
		return 6
	}
	if snapshot() != 106 {
		return 7
	}
	let bytes: [5]u8 = [1, 2, 2, 5, 4]
	if rises(bytes) != 2 {
		return 8
	}
	if over_nothing() != 0 || long_snapshot() != 120 {
		return 9
	}
	return 0
}
