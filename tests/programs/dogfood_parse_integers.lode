// stdout: 0 -> 0\n
// stdout: 12345 -> 12345\n
// stdout: 4294967295 -> 4294967295\n
// stdout: 4294967296 -> overflow\n
// stdout: 99999999999 -> overflow\n
// stdout: 12a4 -> bad digit at 2\n
// stdout:  -> empty\n
package main

import "std/io"

enum ParseError {
	empty
	invalid_digit(pos: usize)
	overflow
}

enum ParseResult {
	ok(value: u32)
	err(e: ParseError)
}

// Parse an unsigned decimal number, rejecting overflow.
fn parse_u32(s: []u8) -> ParseResult {
	if s.len == 0 {
		return ParseResult.err(ParseError.empty)
	}
	var n: u32 = 0
	for i in 0..s.len {
		let c = s[i]
		if c < '0' || c > '9' {
			return ParseResult.err(ParseError.invalid_digit(i))
		}
		let d = c - '0'
		// WORKAROUND: natural `if n > (MAX - d) / 10 { overflow }; n = n * 10 + d`
		// isn't provable; go through u64 instead.
		let w = u64(n) * 10 + d
		if w > 4294967295 {
			return ParseResult.err(ParseError.overflow)
		}
		n = u32(w)
	}
	return ParseResult.ok(n)
}

fn report(s: str) {
	io.print(s)
	io.print(" -> ")
	match parse_u32(s.bytes()) {
		ok(v) => io.print_u64(v)
		err(e) => {
			match e {
				empty => io.print("empty")
				invalid_digit(p) => {
					io.print("bad digit at ")
					io.print_u64(p)
				}
				overflow => io.print("overflow")
			}
		}
	}
	io.print("\n")
}

fn main() -> u8 {
	report("0")
	report("12345")
	report("4294967295")
	report("4294967296")
	report("99999999999")
	report("12a4")
	report("")
	return 0
}
