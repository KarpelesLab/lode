// stdout: 0 1 9 10 99 100 4294967296\n
// stdout: 18446744073709551615 18446744073709551614\n
// stdout: 0 1 -1 -9 -10 42 -123456789\n
// stdout: 9223372036854775807 -9223372036854775807 -9223372036854775808\n
// stdout: 255 -128 65535\n
package main

import "std/io"

const BIG: u64 = 18446744073709551615

fn unsigned() {
	let values: [7]u64 = [0, 1, 9, 10, 99, 100, 4294967296]
	for i in 0..values.len {
		if i > 0 {
			io.print(" ")
		}
		io.print_int(values[i])
	}
	io.print("\n")
	io.print_int(BIG)
	io.print(" ")
	io.print_int(BIG - 1)
	io.print("\n")
}

fn signed() {
	let values: [7]i64 = [0, 1, -1, -9, -10, 42, -123456789]
	for i in 0..values.len {
		if i > 0 {
			io.print(" ")
		}
		io.print_int(values[i])
	}
	io.print("\n")
	io.print_int[i64](9223372036854775807)
	io.print(" ")
	io.print_int[i64](-9223372036854775807)
	io.print(" ")
	io.print_int[i64](-9223372036854775808)
	io.print("\n")
}

// `print_int` takes any integer type.
fn narrow() {
	let a: u8 = 255
	let b: i8 = -128
	let c: u16 = 65535
	io.print_int(a)
	io.print(" ")
	io.print_int(b)
	io.print(" ")
	io.print_int(c)
	io.print("\n")
}

fn main() {
	unsigned()
	signed()
	narrow()
	// Standard error isn't part of the expected output.
	io.eprint_int[u8](7)
	io.eprint_int[i8](-7)
}
