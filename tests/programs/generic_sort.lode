// stdout: -50 -3 -3 0 2 5 7 9 100\n
// stdout: 0 1 1 2 3 4 5 6 9 255\n
// stdout: false false false true true\n
// stdout: 9 1 3 5 0\n
// stdout: sorted\n
package main

import "std/io"
import "std/slices"

fn show[T: Integer](xs: []T) {
	for i in 0..xs.len {
		if i > 0 {
			io.print(" ")
		}
		io.print_int(xs[i])
	}
	io.print("\n")
}

fn main() {
	var a: [9]i64 = [5, -3, 9, 0, 7, -3, 2, 100, -50]
	slices.sort(&a)
	show(a)

	var b: [10]u8 = [9, 1, 255, 0, 4, 3, 1, 6, 5, 2]
	slices.sort(&b)
	show(b)

	var c: [5]bool = [true, false, true, false, false]
	slices.sort(&c)
	for i in 0..c.len {
		if i > 0 {
			io.print(" ")
		}
		if c[i] {
			io.print("true")
		} else {
			io.print("false")
		}
	}
	io.print("\n")

	// Part of an array, through a slice.
	var d: [5]usize = [9, 5, 3, 1, 0]
	slices.sort(&d[1..4])
	show(d)

	var empty: [0]u32 = []
	slices.sort(&empty)
	var one: [1]u32 = [7]
	slices.sort(&one)
	if slices.is_sorted(a) && slices.is_sorted(b) && slices.is_sorted(c) &&
		slices.is_sorted(empty) && slices.is_sorted(one) && !slices.is_sorted(d) {
		io.print("sorted\n")
	}
}
