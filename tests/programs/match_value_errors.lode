package main

enum Op {
	add(n: u8)
	neg
}

fn f(k: u8, b: bool, n: u8, op: Op) -> u8 {
	match k {
		0..=9 => return 1
		11..=255 => return 2
	}
	match b {
		true => return 1
	}
	match k {
		1 | 2 => return 1
		2 => return 2
		_ => return 3
	}
	match k {
		5..=1 => return 1
		n => return 2
		_ => return 3
	}
	match b {
		false..=true => return 1
		true | false => return 2
		_ => return 3
	}
	match op {
		1 => return 1
		add(x) | neg => return 2
	}
	match k {
		0 => return 0
		// `k` is 1..=255 here, but nothing more: `k - 2` isn't proven.
		_ => return k - 1 + (k - 2)
	}
}

fn main() -> u8 {
	return f(1, true, 2, Op.neg)
}
