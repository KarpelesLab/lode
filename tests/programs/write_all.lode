// stdout: ok\n
package main

import "std/os"

// `os.write_all`'s exits: an error number, nothing to write, and success.
fn main() -> u8 {
	if os.write_all(-1, "x") != -9 {
		return 1 // EBADF
	}
	if os.write_all(os.STDOUT, "") != 0 {
		return 2
	}
	if os.write_all(os.STDOUT, "ok\n") != 0 {
		return 3
	}
	return 0
}
