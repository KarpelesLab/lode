// stdout: 907060870 5 500000500000 12 1 9 6 12 8\n
package main

import "std/io"
import "std/math"
import "std/slices"

// Computed while compiling, by ordinary functions, and kept in read-only
// data like any array constant.
const CRC_TABLE: [256]u32 = make_crc_table()
const SQUARES: [10]u64 = squares()

// Constants built from other constants, and from generic functions.
const LIMIT: u32 = 3 * 4
const BIGGEST: u32 = math.max(LIMIT, 7)
const SORTED: [5]u8 = sorted([5, 3, 9, 1, 4])
const LEN: usize = "hello".len + DAYS.len
const DAYS: [3]u8 = [31, 28, 31]

// Structs, enums and optionals.
const ORIGIN: Point = Point{x: 3, y: SQUARES[2]}
const PAIR: ?Pair = find(3)
const KIND: Kind = .wide(LIMIT)
const ENABLED: bool = LIMIT > 10

// Two million steps: more than the default budget.
@comptime_budget(5000000)
const SUM: u64 = sum_to(1000000)

struct Point {
	x: u64
	y: u64
}

struct Pair {
	a: u8
	b: u8
}

enum Kind {
	narrow
	wide(n: u32)
}

/// The CRC-32 table (polynomial 0xedb88320).
fn make_crc_table() -> [256]u32 {
	var table: [256]u32 = [0; 256]
	for n in 0..256 {
		var c = u32(n)
		for k in 0..8 {
			if c & 1 == 1 {
				c = 0xedb88320 ^ (c >> 1)
			} else {
				c = c >> 1
			}
		}
		table[n] = c
	}
	return table
}

fn crc32(data: []u8) -> u32 {
	var c: u32 = 0xffffffff
	for b in data {
		c = CRC_TABLE[(c ^ u32(b)) & 0xff] ^ (c >> 8)
	}
	return c ^ 0xffffffff
}

fn squares() -> [10]u64 {
	var out: [10]u64 = [0; 10]
	for i in 0..10 {
		out[i] = u64(i) * u64(i)
	}
	return out
}

fn sorted(xs: [5]u8) -> [5]u8 {
	var out = xs
	slices.sort(&out)
	return out
}

fn find(k: u8) -> ?Pair {
	for i in 0..10 {
		if u8(i) == k {
			return Pair{a: k, b: u8(i) * 2}
		}
	}
	return none
}

fn sum_to(n: u64) -> u64 {
	var s: u64 = 0
	var i: u64 = 0
	while i < n {
		i += 1
		s = s +% i
	}
	return s
}

fn show(n: u64) {
	io.print_int(n)
	io.print(" ")
}

fn main() {
	io.print_int(crc32("hello".bytes()))
	io.print(" ")
	// An element's range is known: 81 + 4 is proven not to overflow.
	show(SQUARES[9] + ORIGIN.y - 80)
	show(SUM)
	show(u64(BIGGEST))
	show(u64(SORTED[0]))
	show(u64(SORTED[4]))
	let p = PAIR ?? Pair{a: 0, b: 0}
	show(u64(p.b))
	match KIND {
		narrow => show(0)
		wide(n) => show(u64(n))
	}
	if ENABLED {
		io.print_int(LEN)
	}
	io.print("\n")
}
