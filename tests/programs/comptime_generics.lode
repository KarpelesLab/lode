// stdout: 8 4 7 3 2 5\n
package main

import "std/buf"
import "std/io"
import "std/math"
import "std/vec"

// Generic functions, value parameters and generic types, run while
// compiling. A computed constant can be a value argument: `StackBuf[SIZE]`.
const SIZE: usize = math.max[usize](4, 3) * 2
const BIG: u32 = math.max[u32](3, 4)
const FILLED: [6]u16 = filled[u16, 6](7)
const PAIR: Pair[u8, bool] = Pair{first: 3, second: true}
const LIST_LEN: usize = list_len()
const DIGITS: usize = digits(12345)

struct Pair[A, B] {
	first: A
	second: B
}

fn filled[T: Integer, N: usize](v: T) -> [N]T {
	var out: [N]T = [0; N]
	for i in 0..N {
		out[i] = v
	}
	return out
}

fn list_len() -> usize {
	var v = vec.ArrayVec[u8, 8].new()
	v.push(1) catch _ {}
	v.push(2) catch _ {}
	return v.len()
}

fn digits(n: u32) -> usize {
	var b = buf.StackBuf[SIZE].new_end()
	var k = n
	loop {
		b.push_front(u8(k % 10) + 48) catch _ {
			return 0
		}
		k = k / 10
		if k == 0 {
			break
		}
	}
	return b.len()
}

fn main() -> u8 {
	var b = buf.StackBuf[SIZE].new()
	b.push(1) catch _ {}
	io.print_int(SIZE)
	io.print(" ")
	io.print_int(BIG)
	io.print(" ")
	io.print_int(FILLED[5])
	io.print(" ")
	io.print_int(PAIR.first)
	io.print(" ")
	io.print_int(LIST_LEN)
	io.print(" ")
	io.print_int(DIGITS)
	io.print("\n")
	return 0
}
