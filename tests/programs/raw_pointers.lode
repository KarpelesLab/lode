// stdout: hi\nok\n
package main

import "std/os"

// The bytes of a slice, from its raw pointer.
fn write_bytes(fd: i32, bytes: []u8) -> isize {
	unsafe {
		return os.write(fd, bytes.ptr, bytes.len)
	}
}

fn main() -> u8 {
	// An array's pointer views it in place, so it sees the assignments.
	var buf: [4]u8 = [0; 4]
	buf[1] = 'h'
	buf[2] = 'i'
	buf[3] = '\n'
	unsafe {
		if os.write(os.STDOUT, buf.ptr + 1, buf.len - 1) != 3 {
			return 1
		}
	}
	let ok: [3]u8 = ['o', 'k', '\n']
	if write_bytes(os.STDOUT, ok) != 3 {
		return 2
	}
	return 0
}
