package main

import "std/io"

struct Point {
	x: u32
}

fn main() {
	let x: u32 = 1
	let s = "abc"
	io.print("{} {}\n", x)
	io.print("{}\n", x, x)
	io.eprint("no placeholder\n", x)
	io.print("a { b\n", x)
	io.print("a {{ {\n", x)
	io.print("a } b\n")
	io.print("tab\t{:x}\n", x)
	io.print("{}\n", Point{x: 1})
	io.eprint("{}\n", s.bytes())
	io.print(s)
	io.print("{}\n", 5)
	io.print("x = {}, y = {}, z = {}\n", x, x)
	io.print("no args{}")
	var out = io.stdout()
	let f = "{}"
	io.write_fmt(&out, f, x) catch _ {
	}
}
