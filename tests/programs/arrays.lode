// exit: 0
package main

const N = 4
const ROWS: usize = 3

// Arrays are values: a copy doesn't see later changes to the original.
fn copies_are_values() -> bool {
	var a: [N]u32 = [1, 2, 3, 4]
	let b = a
	a[0] = 9
	return a[0] == 9 && b[0] == 1 && b.len == 4
}

// Swapping through a literal that reads the array it's assigned to.
fn swap_through_literal() -> bool {
	var a: [2]u8 = [1, 2]
	a = [a[1], a[0]]
	return a[0] == 2 && a[1] == 1
}

// Nested arrays: rows are arrays too, and can be copied out and assigned.
fn nested() -> bool {
	var m: [ROWS][2]u8 = [[1, 2], [3, 4], [5, 6]]
	m[1][0] = 30
	let row = m[2]
	m[0] = row
	m[2][1] = m[2][1] +% 10
	return m[0][0] == 5 && m[0][1] == 6 && m[1][0] == 30 && m[2][1] == 16 && row[1] == 6
}

// `[value; count]`, including arrays long enough to be filled and copied in
// a loop.
fn repeat() -> bool {
	let zeros: [16]u8 = [0; 16]
	var big: [100]u64 = [7; 100]
	big[99] = 1
	let copy = big
	let grid: [4][4]bool = [[false; 4]; N]
	return zeros[15] == 0 && copy[0] == 7 && copy[98] == 7 && copy[99] == 1 && !grid[3][3]
}

fn next(n: u32) -> u32 {
	return n +% 1
}

// The element type comes from the first element with a type of its own.
fn inferred_elements() -> u32 {
	let x: u32 = 5
	let a = [1, x, next(x)]
	return a[0] +% a[1] +% a[2]
}

// `op=` on an element, with a computed index (evaluated once).
fn compound_assignment() -> bool {
	var counts: [3]u32 = [8; 3]
	var i: usize = 0
	while i < 3 {
		counts[(i + 1) % 3] /= 2
		i = i + 1
	}
	counts[0] *= 1
	return counts[0] == 4 && counts[1] == 4 && counts[2] == 4
}

fn signed_and_wide() -> bool {
	var a: [3]i64 = [-1, 0, 9_000_000_000]
	a[1] = a[0] -% 1
	return a[1] == -2 && a[2] == 9_000_000_000
}

fn main() -> u8 {
	if !copies_are_values() {
		return 1
	}
	if !swap_through_literal() {
		return 2
	}
	if !nested() {
		return 3
	}
	if !repeat() {
		return 4
	}
	if inferred_elements() != 12 {
		return 5
	}
	if !compound_assignment() {
		return 6
	}
	if !signed_and_wide() {
		return 7
	}
	return 0
}
