package main

struct Point {
	x: u8
}

const SHORT: [3]u8 = [1, 2]
const CALLED: [2]u8 = [1, one()]
const POINTS: [2]Point = [Point{x: 1}, Point{x: 2}]
const HUGE: [20000000]u8 = [0; 20000000]
const NOT_ARRAY: [2]u8 = SQUARE
const SQUARE: u8 = 4
const TABLE: [4]u8 = [10, 20, 30, 40]

fn one() -> u8 {
	return 1
}

fn clear(inout xs: [4]u8) {
	xs[0] = 0
}

fn main() -> u8 {
	TABLE[0] = 1
	TABLE = [1, 2, 3, 4]
	clear(&TABLE)
	var i: usize = 4
	let a = TABLE[i]
	return pick(a)
}

// The elements are 10..=40: `- 10` is proven, `- 11` is not.
fn pick(k: u8) -> u8 {
	if k < 4 {
		return TABLE[k] - 10 + (TABLE[k] - 11)
	}
	return 0
}
