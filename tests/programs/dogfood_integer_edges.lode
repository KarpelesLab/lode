// stdout: 44 100 32 0 56 -16 255 100 0 -128 \n
// stdout: 255 1 0 127 -127 -128 255 0 -128 -127 \n
// stdout: 32 2 255 -128 126 127 32 2 127 126 \n
// stdout: 2 1073741824 -4 -16 2147483646 -16 -7 \n
// stdout: 2443359168 38177487 -268435456 0 3989547399 -2147483648 -2147483647 \n
// stdout: 2147483648 0 0 -2147483648 4294967294 0 1 \n
// stdout: -3 -1 \n
// stdout: -2147483648 0 \n
// stdout: 2 1 \n
// stdout: [1][3]ok<5>7 <7><8>9 \n
// stdout: T F T T F F T \n
package main

import "std/io"

fn p(v: i64) {
	io.print_i64(v)
	io.print(" ")
}

fn u(v: u64) {
	io.print_u64(v)
	io.print(" ")
}

fn nl() {
	io.print("\n")
}

fn small_wrapping(a: u8, b: u8, c: i8, d: i8) {
	u(a +% b)
	u(a -% b)
	u(a *% b)
	p(c +% d)
	p(c -% d)
	p(c *% d)
	u(a +| b)
	u(a -| b)
	p(c +| d)
	p(c -| d)
	nl()
}

fn shifts(x: u32, n: u32, s: i32) {
	u(x <<% n)
	u(x >> (n & 31))
	p(s >> (n & 31))
	p(s <<% n)
	u(x ^ 0xffffffff)
	p(s & -16)
	p(s | 1)
	nl()
}

fn signed_div(a: i32, b: i32) {
	if b > 0 {
		p(a / b)
		p(a % b)
	}
	nl()
}

fn trace(tag: u8, v: bool) -> bool {
	io.print("[")
	io.print_u64(tag)
	io.print("]")
	return v
}

fn trace_opt(tag: u8, v: ?u16) -> ?u16 {
	io.print("<")
	io.print_u64(tag)
	io.print(">")
	return v
}

fn order() {
	if trace(1, false) && trace(2, true) {
		io.print("bad")
	}
	if trace(3, true) || trace(4, true) {
		io.print("ok")
	}
	let a = trace_opt(5, 7) ?? trace_opt(6, 8) ?? 9
	u(a)
	let b = trace_opt(7, none) ?? trace_opt(8, none) ?? 9
	u(b)
	nl()
}

struct Mixed {
	a: u8
	b: u64
	c: bool
	d: i16
	e: ?u8
}

enum Pad {
	small(x: u8)
	big(y: u64, z: u8)
	none_
}

fn equality() {
	let m1 = Mixed{a: 1, b: 2, c: true, d: -3, e: none}
	var m2 = m1
	b(m1 == m2)
	m2.e = 0
	b(m1 == m2)
	m2.e = none
	b(m1 == m2)
	let p1 = Pad.small(5)
	let p2 = Pad.big(5, 5)
	let p3 = Pad.small(5)
	b(p1 == p3)
	b(p1 == p2)
	b(Pad.big(1, 2) == Pad.big(1, 3))
	b(Pad.none_ == Pad.none_)
	nl()
}

fn b(v: bool) {
	if v {
		io.print("T ")
	} else {
		io.print("F ")
	}
}

fn main() -> u8 {
	small_wrapping(200, 100, -100, 100)
	small_wrapping(0, 255, -128, -1)
	small_wrapping(17, 15, 127, 1)
	shifts(0x80000001, 1, -8)
	shifts(0x12345678, 35, -2147483648)
	shifts(1, 31, 1)
	signed_div(-7, 2)
	signed_div(-2147483648, 1)
	signed_div(7, 3)
	order()
	equality()
	return 0
}
