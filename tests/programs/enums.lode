// exit: 0
package main

struct Point {
	x: i32
	y: i32
}

enum Shape {
	circle(center: Point, radius: u32)
	rect(min: Point, max: Point)
	dot
}

// An enum in a payload, and a payload with an array.
enum Command {
	draw(shape: Shape, times: u8)
	path(steps: [4]u8)
	stop
}

struct Canvas {
	last: Shape
	shapes: [3]Shape
}

// Big enough that copies and comparisons loop over the elements.
enum Blob {
	empty
	full(bytes: [64]u8)
}

fn area(s: Shape) -> i32 {
	match s {
		circle(_, r) => {
			let r32 = i32(r & 0xff)
			return 3 * r32 * r32
		}
		rect(a, b) => return (b.x -% a.x) *% (b.y -% a.y)
		dot => return 0
	}
}

fn name(s: Shape) -> u8 {
	match s {
		circle => return 1
		rect => return 2
		dot => return 3
	}
}

// Construct and match each variant, binding payload fields.
fn variants() -> bool {
	let c = Shape.circle(Point{x: 1, y: 2}, 4)
	let r = Shape.rect(Point{x: 0, y: 0}, Point{x: 3, y: 5})
	let d = Shape.dot
	var center: i32 = 0
	match c {
		circle(p, _) => center = p.x +% p.y
		rect => return false
		dot => return false
	}
	return area(c) == 48 && area(r) == 15 && area(d) == 0 && center == 3 && name(d) == 3
}

fn grow(s: Shape) -> Shape {
	match s {
		circle(p, r) => return Shape.circle(p, r +% 1)
		rect(a, b) => return Shape.rect(a, Point{x: b.x +% 1, y: b.y})
		dot => return Shape.circle(Point{x: 0, y: 0}, 1)
	}
}

// Passing and returning by value; copies are independent.
fn values() -> bool {
	var s = Shape.dot
	s = grow(s)
	s = grow(s)
	let copy = s
	s = Shape.dot
	var t = Shape.rect(Point{x: 1, y: 1}, Point{x: 2, y: 2})
	t = grow(t)
	return copy == Shape.circle(Point{x: 0, y: 0}, 2) && s == Shape.dot && area(t) == 2
}

// Nested enums, enums in structs and arrays.
fn nesting() -> bool {
	let cmd = Command.draw(Shape.circle(Point{x: 0, y: 0}, 2), 3)
	var total: i32 = 0
	match cmd {
		draw(shape, times) => {
			match shape {
				circle(_, r) => total = i32(r & 0xff) * i32(times)
				rect => return false
				dot => return false
			}
		}
		path(steps) => total = i32(steps[0])
		stop => return false
	}
	var canvas = Canvas{last: Shape.dot, shapes: [Shape.dot; 3]}
	canvas.shapes[1] = Shape.circle(Point{x: 5, y: 5}, 1)
	canvas.last = canvas.shapes[1]
	canvas.shapes[1] = Shape.dot
	var circles: u8 = 0
	for s in canvas.shapes {
		if s != Shape.dot {
			circles = circles +% 1
		}
	}
	let p = Command.path([1, 2, 3, 4])
	var first: u8 = 0
	match p {
		path(steps) => first = steps[3]
		draw => return false
		stop => return false
	}
	return total == 6 && circles == 0 && area(canvas.last) == 3 && first == 4 && p != cmd
}

// Structural equality: same variant, then same payload.
fn equality() -> bool {
	let a = Shape.circle(Point{x: 1, y: 2}, 3)
	let b = Shape.circle(Point{x: 1, y: 2}, 3)
	let c = Shape.circle(Point{x: 1, y: 2}, 4)
	let r = Shape.rect(Point{x: 1, y: 2}, Point{x: 3, y: 0})
	let x = Command.draw(a, 1)
	return a == b && a != c && a != r && x == Command.draw(b, 1) && x != Command.draw(b, 2) && Command.stop == Command.stop
}

fn filled(v: u8) -> Blob {
	return Blob.full([v; 64])
}

fn large() -> bool {
	let a = filled(7)
	var b = a
	let same = a == b
	b = filled(8)
	var sum: u32 = 0
	match a {
		full(bytes) => {
			for x in bytes {
				sum = sum +% u32(x)
			}
		}
		empty => return false
	}
	return same && a != b && b != Blob.empty && sum == 448
}

enum Pick {
	one(x: u8)
	two(p: [2]u16, q: ?u8)
}

struct Holder {
	pick: Pick
	maybe: ?Pick
}

fn make(k: u8) -> Pick {
	if k == 0 {
		return Pick.one(7)
	}
	return Pick.two([1, 2], k)
}

// Matching fields and calls, and `if let` on a field.
fn places() -> u8 {
	var h = Holder{pick: make(1), maybe: none}
	var r: u8 = 0
	match h.pick {
		one(x) => r = x
		two(p, q) => r = u8(p[1] & 0xff) +% (q ?? 50)
	}
	match make(0) {
		one(x) => r = r +% x
		two => return 1
	}
	h.maybe = make(0)
	if let p = h.maybe {
		if p == Pick.one(7) {
			r = r +% 10
		}
	} else if let z = h.maybe {
		return 2
	}
	return r
}

fn main() -> u8 {
	if !variants() {
		return 1
	}
	if !values() {
		return 2
	}
	if !nesting() {
		return 3
	}
	if !equality() {
		return 4
	}
	if !large() {
		return 5
	}
	if places() != 20 {
		return 6
	}
	return 0
}
