package main

fn add(a: u32, b: u32) -> u32 {
	return a + b
}

fn div(a: i32, b: i32) -> i32 {
	return a / b
}

fn narrow(x: u32) -> u8 {
	return u8(x)
}

fn shift(x: u32, n: u32) -> u32 {
	return x << n
}

fn neg(x: i32) -> i32 {
	return -x
}

fn neg_unsigned(x: u32) -> u32 {
	return -x
}
