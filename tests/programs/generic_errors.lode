package main

struct Point {
	x: u32
}

fn largest[T: Ordered](sink a: T, sink b: T) -> T {
	if a.lt(b) {
		return b
	}
	return a
}

fn twice[T: Integer](x: T) -> T {
	return x +| x
}

fn plain(x: u32) -> u32 {
	return x
}

// Operators need a numeric bound; `Ordered` gives methods.
fn less[T: Ordered](a: T, b: T) -> bool {
	return a < b
}

fn add[T: Ordered](a: T, b: T) -> T {
	return a +% b
}

// `==` needs `Eq`.
fn same[T](a: T, b: T) -> bool {
	return a == b
}

// Methods come from the bounds only.
fn below[T](a: T, b: T) -> bool {
	return a.lt(b)
}

fn size[T: Copy](a: T) -> usize {
	return a.len()
}

// A result must fit in every type `T` can be.
fn next[T: Integer](a: T) -> T {
	return a + 1
}

fn big[T: Integer]() -> T {
	return 200
}

fn neg[T: Integer](a: T) -> T {
	return -a
}

fn shift[T: Unsigned](a: T) -> T {
	return a << 8
}

fn narrow[T: Unsigned](a: u32) -> T {
	return T(a)
}

fn not_a_number[T: Ordered]() -> T {
	return 0
}

// A type argument is checked against the bounds where it's given.
fn pass_on[U](x: U) -> U {
	return twice(x)
}

// Instances that never end (reported once, though a loop's body is
// checked several times).
fn nest[T: Copy](x: T) -> u32 {
	var n: u32 = 0
	while n < 3 {
		let o: ?T = x
		n = nest(o)
	}
	return n
}

fn unknown_trait[T: Sortable](x: T) {
}

fn both[T: Unsigned + Signed](x: T) {
}

fn trait_as_type(x: Ordered) {
}

fn twice_declared[T, T](x: T) {
}

fn main() {
	let p = Point{x: 1}
	let q = largest(p, p)
	let r = twice(true)
	let s = largest(3, 4)
	twice(5)
	let t = largest[u8, u8](1, 2)
	let u = plain[u32](1)
	let xs: [2]u8 = [1, 2]
	let v = xs[u32]
	let w = xs[0, 1]
	let y = largest[1 + 1](1, 2)
	let z = largest[str]("a", "b")
	let f = largest[u8]
}
