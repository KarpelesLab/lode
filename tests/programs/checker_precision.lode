// exit: 0
package main

// Division and shifts by constants narrow the range: `x / 2` and `x >> 1`
// are at most half the largest `u64`, so adding 1 can't overflow.
fn half_plus_one(x: u64) -> u64 {
	let d = x / 2
	let s = x >> 1
	return d + 1 + (s - s)
}

// Signed division rounds toward zero; a signed shift rounds down. Both
// keep half the range, so doubling the result fits again.
fn halves(x: i64) -> i64 {
	let q = x / 2
	let s = x >> 1
	return q * 2 + (s - s)
}

// `%` keeps the sign of the dividend: a non-negative `x % 10` is a digit.
fn last_digit(x: i32) -> u8 {
	if x < 0 {
		return 0
	}
	return u8(x % 10)
}

// Of non-negative values, `|` stays below the next power of two:
// `v | (v >> 1)` with `v <= 0x7fffffff` is too, so `+ 1` fits a `u32`.
fn smear(x: u32) -> u32 {
	var v = x & 0x7fffffff
	v = v | (v >> 1)
	v = v | (v >> 2)
	v = v | (v >> 4)
	v = v | (v >> 8)
	v = v | (v >> 16)
	return v + 1
}

// `x & mask` with a non-negative mask is in `0..=mask`, whatever `x` is.
fn low_byte(x: i32) -> u8 {
	return u8(x & 0xff)
}

const MIN: i64 = -9223372036854775808

// `b == 0` being false leaves a hole at 0 in `b`'s range, which proves the
// divisor isn't zero; `b == -1` being false, that it isn't -1.
fn divide(a: i64, b: i64) -> ?i64 {
	if b == 0 {
		return none
	}
	if b == -1 {
		if a == MIN {
			return none
		}
		return -a
	}
	return a / b
}

// The same for `!=`: `a` is neither 0 nor -1 where `r / a` is.
fn mul_fits(a: i64, b: i64) -> bool {
	let r = a *% b
	if a == -1 {
		return b != MIN
	}
	if a != 0 {
		return r / a == b
	}
	return true
}

// Holes go through loops when every iteration keeps them, and a copy has
// the holes of what it copies: `d` is never 0 here.
fn sum_of_quotients(xs: []i32, d0: i32) -> i32 {
	if d0 == 0 || d0 == -1 {
		return 0
	}
	var total: i32 = 0
	var d = d0
	for x in xs {
		total = total +% x / d0
		total = total +% 1000 / d
		if x != 0 {
			d = x
		}
	}
	return total
}

// A counter that grows by at most 1 per iteration of a `for` loop stays at
// most the index: `n <= $i` at the head, so `n + 1` can't overflow, and
// after the loop, `n <= xs.len`.
fn count_zeros(xs: []u8) -> usize {
	var n: usize = 0
	for x in xs {
		if x == 0 {
			n = n + 1
		}
	}
	return xs.len - n
}

// The same with a `while` loop and an index of its own.
fn count_small(xs: []u8) -> usize {
	var i: usize = 0
	var n: usize = 0
	while i < xs.len {
		if xs[i] < 10 {
			n = n + 1
		}
		i = i + 1
	}
	return i - n
}

// Compacting in place: the write index never passes the read index, so
// `buf[w]` is proven.
fn compact() -> usize {
	var buf: [8]u8 = [1, 0, 2, 0, 0, 3, 4, 0]
	var w: usize = 0
	for r in 0..buf.len {
		if buf[r] != 0 {
			buf[w] = buf[r]
			w = w + 1
		}
	}
	return w * 10 + usize(buf[0])
}

// Two copies of `pos`, one moving forward and one catching up with it:
// `start <= i` holds at the head and after the loop.
fn last_word_len(src: []u8, pos: usize) -> usize {
	var i = pos
	var start = pos
	while i < src.len {
		if src[i] == ' ' {
			start = i + 1
		}
		i = i + 1
	}
	return i - start
}

fn main() -> u8 {
	if half_plus_one(18446744073709551615) != 9223372036854775808 {
		return 1
	}
	if halves(-7) != -6 || halves(7) != 6 {
		return 2
	}
	if last_digit(1234) != 4 || last_digit(-5) != 0 {
		return 3
	}
	if smear(1000) != 1024 || smear(4294967295) != 2147483648 {
		return 4
	}
	if low_byte(-1) != 255 {
		return 5
	}
	if divide(7, 0) != none || divide(MIN, -1) != none || divide(7, -1) ?? 0 != -7 || divide(-7, 2) ?? 0 != -3 {
		return 6
	}
	if !mul_fits(3, 4) || mul_fits(-1, MIN) || mul_fits(4611686018427387904, 2) || !mul_fits(0, MIN) {
		return 7
	}
	let xs: [3]i32 = [10, -20, 35]
	if sum_of_quotients(xs, 5) != 255 || sum_of_quotients(xs, -1) != 0 {
		return 8
	}
	let ys: [6]u8 = [0, 5, 0, 20, 0, 7]
	if count_zeros(ys) != 3 || count_small(ys) != 1 {
		return 9
	}
	if compact() != 41 {
		return 10
	}
	let text: [9]u8 = ['a', 'b', ' ', 'c', 'd', 'e', ' ', 'f', 'g']
	if last_word_len(text, 0) != 2 || last_word_len(text, 8) != 1 || last_word_len(text, 20) != 0 {
		return 11
	}
	return 0
}
