package main

import "std/io"

struct Point {
	x: u32
}

struct Many[..A] {
	x: u8
}

fn Point.f(self, comptime n: u32) {
}

fn not_last[..A: io.Format, T](args: ..A) {
}

fn pack_first[..A: io.Format](args: ..A, n: u32) {
}

fn not_a_pack[T](args: ..T) {
}

fn no_param[..A: io.Format](n: u32) {
}

fn struct_param(comptime p: Point) {
}

fn breaks(comptime n: usize) {
	comptime for i in 0..n {
		break
	}
}

fn picks(comptime n: u32) {
	match comptime n {
		0 => io.print("zero\n")
	}
}

fn known() {
	let v: u32 = 3
	comptime let w = v + 1
}

fn uses_pack[..A: io.Format](args: ..A) {
	let a = args
	io.print("{}", args[2])
}

fn need_even(comptime n: u32) {
	if comptime n % 2 != 0 {
		compile_error("{} is odd", n)
	}
}

fn short(comptime s: str) {
	if comptime s.len > 3 {
		compile_error_at(s[3..], "too long: `{}`", s)
	}
}

fn deep(comptime n: u32) {
	deep(n + 1)
}

fn main() {
	breaks(2)
	picks(1)
	uses_pack(u8(1))
	need_even(4)
	need_even(3)
	short("abc")
	short("abcdef")
	let x: u32 = 1
	io.print("{}", ..x)
	deep(0)
}
