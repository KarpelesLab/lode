package main

// A constant index past the end.
fn past_the_end() -> u8 {
	let a: [4]u8 = [1, 2, 3, 4]
	return a[4]
}

// A variable index with no check.
fn unguarded(i: usize) -> u8 {
	let a: [4]u8 = [1, 2, 3, 4]
	return a[i]
}

// A slice index with no check.
fn slice_unchecked(xs: []u32) -> u32 {
	return xs[0]
}

// The check was on another slice.
fn wrong_slice(xs: []u32, ys: []u32, i: usize) -> u32 {
	if i < xs.len {
		return ys[i]
	}
	return 0
}

// The bound changes in the loop body, so the loop variable isn't related to it.
fn moving_bound(xs: []u32) -> u32 {
	var n = xs.len
	var total: u32 = 0
	for i in 0..n {
		n = 0
		total = total +% xs[i]
	}
	return total
}

// A signed index can be negative.
fn signed(xs: []u32, i: i32) -> u32 {
	if i < 10 {
		return xs[i]
	}
	return 0
}

fn main() {
}
