/// Fixed-capacity vectors.
package vec

import "std/mem"

/// What a vector's operations throw.
pub enum Error {
	/// The vector holds `N` elements already.
	full
}

/// A list of at most `N` elements of type `T`, stored in place (on the
/// stack for a local): no allocation. The first `count` slots hold the
/// elements, the others are `none`.
///
/// `T` can be any type: an element that isn't `Copy` (a type with a
/// `deinit`, like `os.Fd`) is moved in by `push` and out by `pop`, and the
/// elements left are destroyed with the vector (docs/allocation.md,
/// Generics). `get` copies, so it needs `T: Copy`.
pub struct ArrayVec[T, N: usize] {
	slots: [N]?T
	count: usize where count <= N
}

/// An empty vector.
pub fn ArrayVec[T, N].new() -> ArrayVec[T, N] {
	return ArrayVec{slots: [none; N], count: 0}
}

/// The number of elements.
pub fn ArrayVec[T, N].len(self) -> usize {
	return self.count
}

/// Add `v` at the end, or throw `full` if there are `N` elements already
/// (`v` is destroyed then).
pub fn ArrayVec[T, N].push(inout self, sink v: T) throws(Error) {
	if self.count >= N {
		throw .full
	}
	self.slots[self.count] = v
	self.count += 1
}

/// Remove the last element and return it, or `none` if there's none.
pub fn ArrayVec[T, N].pop(inout self) -> ?T {
	if self.count == 0 {
		return none
	}
	let last = self.count - 1
	let v = mem.take(&self.slots[last])
	self.count = last
	return v
}

/// A copy of element `i` (0 is the first), or `none` past the last.
pub fn ArrayVec[T: Copy, N].get(self, i: usize) -> ?T {
	if i >= self.count {
		return none
	}
	return self.slots[i]
}

/// Replace element `i` with `v`, destroying the one it replaces; `false`
/// (and no change, `v` destroyed) if there's no element `i`.
pub fn ArrayVec[T, N].put(inout self, i: usize, sink v: T) -> bool {
	if i >= self.count {
		return false
	}
	self.slots[i] = v
	return true
}
