/// Fixed-capacity byte buffers.
package buf

import "std/os"

/// What a buffer's operations throw.
pub enum Error {
	/// There's no room left at that end.
	full
}

/// A buffer of at most `N` bytes, written at either end: the bytes written
/// so far are `bytes[start..end]`, and only those are read. Appending
/// (`push`) and prepending (`push_front`) check that there's room, so
/// every access is proven. The buffer lives where it's declared, on the
/// stack for a local.
///
/// Its fields are private, and its storage is `@uninit`: `new` and
/// `new_end` don't write it, and this package reads only the bytes written
/// (docs/memory.md, "Uninitialized buffers"). So `StackBuf` isn't `Eq`:
/// `==` would compare the bytes never written too.
pub struct StackBuf[N: usize] {
	@uninit bytes: [N]u8
	start: usize
	end: usize
}

/// An empty buffer that `push` fills from the front of its storage.
pub fn StackBuf[N].new() -> StackBuf[N] {
	// Sound: `bytes` is read only in `start..end`, which `push` and
	// `push_front` write before they move `start` or `end`.
	unsafe {
		return StackBuf{start: 0, end: 0}
	}
}

/// An empty buffer that `push_front` fills from the back of its storage,
/// such as for the digits of a number, last digit first.
pub fn StackBuf[N].new_end() -> StackBuf[N] {
	// Sound, as in `new`.
	unsafe {
		return StackBuf{start: N, end: N}
	}
}

/// The number of bytes written.
pub fn StackBuf[N].len(self) -> usize {
	if self.start > self.end {
		return 0
	}
	return self.end - self.start
}

/// Write `b` after the bytes written so far, or throw `full` when the
/// storage's end is reached.
pub fn StackBuf[N].push(inout self, b: u8) throws(Error) {
	if self.end >= N {
		throw .full
	}
	self.bytes[self.end] = b
	self.end += 1
}

/// Write `b` before the bytes written so far, or throw `full` when the
/// storage's front is reached.
pub fn StackBuf[N].push_front(inout self, b: u8) throws(Error) {
	// `start - 1`, wrapping to the largest `usize` when `start` is 0: one
	// check covers both a full front and a `start` past the storage.
	let at = self.start -% 1
	if at >= N {
		throw .full
	}
	self.bytes[at] = b
	self.start = at
}

/// Byte `i` of the bytes written (0 is the first), or `none` past them.
pub fn StackBuf[N].get(self, i: usize) -> ?u8 {
	// `start + i`, or the largest `usize` if it's larger, which is past
	// the end.
	let at = self.start +| i
	if at >= self.end || at >= N {
		return none
	}
	return self.bytes[at]
}

/// Write the bytes written to the file descriptor `fd`, as `os.write_all`
/// does: returns 0, or the negative error number of the first failure.
/// (`io.File.write_buf` calls it: only this package sees the bytes.)
pub fn StackBuf[N].write_to(self, fd: i32) -> isize {
	if self.start > self.end || self.end > N {
		return 0
	}
	return os.write_all(fd, self.bytes[self.start..self.end])
}
