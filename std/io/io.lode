/// Input and output.
package io

import "std/os"

/// Write `s` to standard output.
///
/// Output errors are ignored: `print` is for programs whose output isn't worth
/// failing over (and a closed pipe already ends the process through SIGPIPE).
/// To handle errors, use `stdout().write(s)`.
pub fn print(s: str) {
	os.write_all(os.STDOUT, s.bytes())
}

/// Write `s` to standard error, ignoring errors like `print`.
pub fn eprint(s: str) {
	os.write_all(os.STDERR, s.bytes())
}

/// An open file, by its file descriptor. It doesn't close the file: the
/// standard ones stay open, and there's no way to open others yet.
pub struct File {
	fd: i32
}

/// Standard input.
pub fn stdin() -> File {
	return File{fd: os.STDIN}
}

/// Standard output.
pub fn stdout() -> File {
	return File{fd: os.STDOUT}
}

/// Standard error.
pub fn stderr() -> File {
	return File{fd: os.STDERR}
}

/// Write all of `s` to the file, or throw the error that stopped it.
///
/// This is the checked way to write: `try io.stdout().write(s)`.
pub fn File.write(self, s: str) throws(os.Error) {
	try self.write_bytes(s.bytes())
}

/// Write all of the bytes `b` to the file, or throw the error that stopped
/// it: raw bytes, such as a buffer a program filled, with no encoding
/// claim.
pub fn File.write_bytes(self, b: []u8) throws(os.Error) {
	let n = os.write_all(self.fd, b)
	if n < 0 {
		throw os.error(n)
	}
}

/// Read from the file into `buf`: returns the number of bytes read, which is
/// 0 only at the end of the input (or if `buf` is empty), and may be fewer
/// than `buf.len` even before the end (a pipe or a terminal gives what it
/// has). Throws the error that stopped it. An interrupted call is retried.
pub fn File.read(self, inout buf: []u8) throws(os.Error) -> usize {
	loop {
		var n: isize
		unsafe {
			n = os.read(self.fd, buf.ptr, buf.len)
		}
		if n == -os.EINTR {
			continue
		}
		if n < 0 {
			throw os.error(n)
		}
		// The kernel never reads more than asked.
		if usize(n) > buf.len {
			throw .io
		}
		return usize(n)
	}
}

/// Read from the file until `buf` is full or the input ends: returns the
/// number of bytes read, which is less than `buf.len` only at the end of the
/// input. Throws the error that stopped it; the bytes read before it are in
/// `buf`, but their count is lost.
pub fn File.read_full(self, inout buf: []u8) throws(os.Error) -> usize {
	var got: usize = 0
	loop {
		if got >= buf.len {
			return got
		}
		var n: isize
		unsafe {
			n = os.read(self.fd, buf.ptr + got, buf.len - got)
		}
		if n == -os.EINTR {
			continue
		}
		if n < 0 {
			throw os.error(n)
		}
		if n == 0 {
			return got
		}
		if usize(n) > buf.len - got {
			throw .io
		}
		got = got + usize(n)
	}
}

// Integer output. `print("{}", n)` will replace these once the compiler has
// `comptime` (docs/comptime.md, "Format strings"), so the set stays small:
// decimal `u64` and `i64`, which every other integer type converts to.

/// Write `n` to standard output in decimal, ignoring errors like `print`.
pub fn print_u64(n: u64) {
	write_decimal(os.STDOUT, n, false)
}

/// Write `n` to standard output in decimal, with a `-` if it's negative,
/// ignoring errors like `print`.
pub fn print_i64(n: i64) {
	write_decimal(os.STDOUT, magnitude(n), n < 0)
}

/// `print_u64` to standard error.
pub fn eprint_u64(n: u64) {
	write_decimal(os.STDERR, n, false)
}

/// `print_i64` to standard error.
pub fn eprint_i64(n: i64) {
	write_decimal(os.STDERR, magnitude(n), n < 0)
}

/// The absolute value of `n`. `-n` overflows for the smallest `i64`, so a
/// negative `n` goes through `n + 1`, which can be negated.
fn magnitude(n: i64) -> u64 {
	if n < 0 {
		return u64(-(n + 1)) + 1
	}
	return u64(n)
}

/// Write `n` in decimal to `fd`, after a `-` if `negative`, in one `write`.
///
/// The digits go into a buffer from the end, and element 0 is kept for the
/// sign. 20 digits hold the largest `u64`, so the loop always ends when `v`
/// is 0; `i <= 1` is what proves there's room (the checker doesn't count
/// digits), and it leaves `i >= 1` for the sign. The output is at most 21
/// bytes, which the kernel writes whole (and Lode installs no signal
/// handlers, so there's no `EINTR`), so one `os.write` is enough.
fn write_decimal(fd: i32, n: u64, negative: bool) {
	var buf: [21]u8 = [0; 21]
	var i = buf.len - 1
	var v = n
	loop {
		buf[i] = '0' + u8(v % 10)
		v = v / 10
		if v == 0 {
			break
		}
		if i <= 1 {
			break
		}
		i = i - 1
	}
	if negative {
		i = i - 1
		buf[i] = '-'
	}
	unsafe {
		os.write(fd, buf.ptr + i, buf.len - i)
	}
}
