/// Input and output.
package io

import "std/buf"
import "std/os"

/// Write the format string `fmt` to standard output, each `{}` in it
/// replaced by the next argument as its `Format` impl writes it:
/// `io.print("x = {}\n", x)`. `{{` and `}}` write a brace. A `str` known
/// only when the program runs is printed with `io.print("{}", s)`.
///
/// The format is read when compiling: a `{` without its `}`, a `}` alone,
/// or a `{}` without an argument (or an argument without a `{}`) is an
/// error at the call, and so is an argument whose type doesn't implement
/// `Format`.
///
/// Each `print` is one `write`. A format that's only text, such as
/// `io.print("hello world\n")`, is written as it is, with no buffer and no
/// formatting code. Otherwise the text and the arguments are put in a
/// buffer of `PRINT_BUF_SIZE` (256) bytes on the stack, written at the end; a
/// print longer than that is written 256 bytes at a time, each time the
/// buffer is full.
///
/// Output errors are ignored: `print` is for programs whose output isn't worth
/// failing over (and a closed pipe already ends the process through SIGPIPE).
/// To handle errors, use `io.write_fmt(&f, fmt, ...)` with `f` a `File`.
pub fn print[..A: Format](comptime fmt: str, args: ..A) {
	// The body is here, and again in `eprint`, rather than in a function
	// both call: an expansion of `print` that only writes text is small
	// enough to be inlined where it's called, with nothing else left.
	comptime let count = format_count(fmt, args.len)
	if comptime count == 1 && args.len == 0 {
		match comptime format_piece(fmt, 0) {
			text(start, end) => {
				comptime let s = fmt[start..end]
				os.write_all(os.STDOUT, s.bytes())
			}
			arg(i) => {
			}
		}
	} else if comptime count > 0 {
		var out = Buffered.new(os.STDOUT)
		comptime for k in 0..count {
			match comptime format_piece(fmt, k) {
				text(start, end) => {
					comptime let s = fmt[start..end]
					out.put(s.bytes(), k + 1 == count)
				}
				arg(i) => {
					args[i].format(&out) catch _ {
					}
					if comptime k + 1 == count {
						out.flush()
					}
				}
			}
		}
	}
}

/// `print` to standard error, one `write` each, ignoring errors like
/// `print`.
pub fn eprint[..A: Format](comptime fmt: str, args: ..A) {
	comptime let count = format_count(fmt, args.len)
	if comptime count == 1 && args.len == 0 {
		match comptime format_piece(fmt, 0) {
			text(start, end) => {
				comptime let s = fmt[start..end]
				os.write_all(os.STDERR, s.bytes())
			}
			arg(i) => {
			}
		}
	} else if comptime count > 0 {
		var out = Buffered.new(os.STDERR)
		comptime for k in 0..count {
			match comptime format_piece(fmt, k) {
				text(start, end) => {
					comptime let s = fmt[start..end]
					out.put(s.bytes(), k + 1 == count)
				}
				arg(i) => {
					args[i].format(&out) catch _ {
					}
					if comptime k + 1 == count {
						out.flush()
					}
				}
			}
		}
	}
}

/// The size of the buffer of `print` and `eprint`: a print longer than this
/// takes more than one `write`.
pub const PRINT_BUF_SIZE: usize = 256

/// Write the format string `fmt` to `w`, each `{}` replaced by the next
/// argument, as `print` does, or throw the error that stopped it:
/// `try io.write_fmt(&f, "{} items\n", n)`.
pub fn write_fmt[W: Writer, ..A: Format](inout w: W, comptime fmt: str, args: ..A) throws(os.Error) {
	comptime let count = format_count(fmt, args.len)
	comptime for k in 0..count {
		match comptime format_piece(fmt, k) {
			text(start, end) => {
				comptime let s = fmt[start..end]
				try w.write_bytes(s.bytes())
			}
			arg(i) => try args[i].format(&w)
		}
	}
}

/// The number of pieces of the format string `fmt`, checked for `given`
/// arguments when compiling: an error in it is reported at the call of
/// `print`, `eprint` or `write_fmt`, pointing into the format string.
fn format_count(comptime fmt: str, comptime given: usize) -> usize {
	comptime let count = format_pieces(fmt, given) catch e {
		match e {
			unclosed(at) => compile_error_at(fmt[at..at + 1], "unclosed `{{` in the format string")
			unmatched(at) => compile_error_at(fmt[at..at + 1], "unmatched `}}` in the format string: `}}}}` writes a brace")
			spec(at, end) => compile_error_at(fmt[at..end], "a placeholder is `{{}}`: format specs are not supported yet")
			missing(at, placeholders, n) => compile_error_at(fmt[at..at + 2], "this `{{}}` has no argument: {} {} but {} {}", placeholders, placeholder_noun(placeholders), n, argument_noun(n))
			unused(placeholders, n) => compile_error("{} {} but {} {}: each argument needs a `{{}}` in the format string", placeholders, placeholder_noun(placeholders), n, argument_noun(n))
		}
	}
	return count
}

/// Standard output or error through a buffer, for `print` and `eprint`:
/// a `Writer` that ignores errors. The bytes put so far are
/// `bytes[..len]`.
///
/// It's one type, not one per buffer size: the `Format` impls and
/// `write_decimal` are made for each type of writer they write to, and a
/// buffer sized for each format string (its text, and 20 bytes for each
/// argument) made programs up to 19 KB larger at `-O2`.
///
/// `bytes` is `@uninit`: `new` doesn't write it, and `put` reads only
/// `bytes[..len]`, which it wrote.
struct Buffered {
	fd: i32
	@uninit bytes: [PRINT_BUF_SIZE]u8
	len: usize
}

/// An empty buffer for `fd`.
fn Buffered.new(fd: i32) -> Buffered {
	// Sound: `put` writes each byte before `len` covers it.
	unsafe {
		return Buffered{fd: fd, len: 0}
	}
}

/// Put `b` after the bytes buffered, writing the buffer each time it's
/// full, and at the end if `last`.
fn Buffered.put(inout self, b: []u8, last: bool) {
	var at = self.len
	if at > PRINT_BUF_SIZE {
		at = 0
	}
	// One loop with one `write_all`, for both reasons to write: the
	// smallest code found.
	var i: usize = 0
	loop {
		if at >= PRINT_BUF_SIZE || i >= b.len && last {
			os.write_all(self.fd, self.bytes[..at])
			at = 0
		}
		if i >= b.len {
			break
		}
		self.bytes[at] = b[i]
		at += 1
		i += 1
	}
	self.len = at
}

/// Write the bytes buffered.
fn Buffered.flush(inout self) {
	self.put("".bytes(), true)
}

impl Writer for Buffered {
	fn write_bytes(inout self, b: []u8) {
		self.put(b, false)
	}
}

/// An open file, by its file descriptor. It doesn't close the file: the
/// standard ones stay open, and there's no way to open others yet.
///
/// Its file descriptor is private: `stdin()`, `stdout()`, `stderr()` and
/// `File.from_fd(fd)` make one.
pub struct File {
	fd: i32
}

/// The file open as the file descriptor `fd`. Reading or writing a
/// descriptor that isn't open throws `bad_fd`.
pub fn File.from_fd(fd: i32) -> File {
	return File{fd: fd}
}

/// Standard input.
pub fn stdin() -> File {
	return File{fd: os.STDIN}
}

/// Standard output.
pub fn stdout() -> File {
	return File{fd: os.STDOUT}
}

/// Standard error.
pub fn stderr() -> File {
	return File{fd: os.STDERR}
}

/// Write all of `s` to the file, or throw the error that stopped it.
///
/// This is the checked way to write: `try io.stdout().write(s)`.
pub fn File.write(self, s: str) throws(os.Error) {
	try self.write_bytes(s.bytes())
}

/// Write all of the bytes `b` to the file, or throw the error that stopped
/// it: raw bytes, such as a buffer a program filled, with no encoding
/// claim.
pub fn File.write_bytes(self, b: []u8) throws(os.Error) {
	let n = os.write_all(self.fd, b)
	if n < 0 {
		throw os.error(n)
	}
}

/// Write the bytes written in the buffer `b` to the file, or throw the
/// error that stopped it.
pub fn File.write_buf[N: usize](self, b: buf.StackBuf[N]) throws(os.Error) {
	let n = b.write_to(self.fd)
	if n < 0 {
		throw os.error(n)
	}
}

/// Something bytes are written to: a file, or a buffer. Generic code takes
/// any of them: `fn greet[W: io.Writer](inout w: W) throws(os.Error)`.
pub trait Writer {
	/// Write all of the bytes `b`, or throw the error that stopped it.
	fn write_bytes(inout self, b: []u8) throws(os.Error)

	/// Write all of `s`, or throw the error that stopped it.
	fn write(inout self, s: str) throws(os.Error) {
		try self.write_bytes(s.bytes())
	}
}

/// A file is a `Writer`. Its own `write` and `write_bytes`, which take
/// `self`, come first in `f.write(s)`; through the trait,
/// `Writer.write(&f, s)` or a generic function, they're these.
impl Writer for File {
	fn write_bytes(inout self, b: []u8) throws(os.Error) {
		try self.write_bytes(b)
	}
}

/// A `StackBuf` is a `Writer`: it throws `no_space` when it's full, after
/// writing what fits.
impl[N: usize] Writer for buf.StackBuf[N] {
	fn write_bytes(inout self, b: []u8) throws(os.Error) {
		for x in b {
			self.push(x) catch _ {
				throw .no_space
			}
		}
	}
}

/// Read from the file into `buf`: returns the number of bytes read, which is
/// 0 only at the end of the input (or if `buf` is empty), and may be fewer
/// than `buf.len` even before the end (a pipe or a terminal gives what it
/// has). Throws the error that stopped it. An interrupted call is retried.
pub fn File.read(self, inout buf: []u8) throws(os.Error) -> usize {
	loop {
		var n: isize
		unsafe {
			n = os.read(self.fd, buf.ptr, buf.len)
		}
		if n == -os.EINTR {
			continue
		}
		if n < 0 {
			throw os.error(n)
		}
		// The kernel never reads more than asked.
		if usize(n) > buf.len {
			throw .io
		}
		return usize(n)
	}
}

/// Read from the file until `buf` is full or the input ends: returns the
/// number of bytes read, which is less than `buf.len` only at the end of the
/// input. Throws the error that stopped it; the bytes read before it are in
/// `buf`, but their count is lost.
pub fn File.read_full(self, inout buf: []u8) throws(os.Error) -> usize {
	var got: usize = 0
	loop {
		if got >= buf.len {
			return got
		}
		let n = try self.read(&buf[got..])
		if n == 0 {
			return got
		}
		if n > buf.len - got {
			throw .io
		}
		got = got + n
	}
}

// Formatting: the `Format` trait, its impls, and the format strings of
// `print` and `write_fmt`, which are read when compiling.

/// A type whose values can be written as text, as `print`'s `{}` does:
/// integers in decimal (with a `-` when negative), `bool` as `true` or
/// `false`, and `str` as it is. Other types implement it with an `impl`:
/// `impl io.Format for Point { ... }`.
pub trait Format {
	/// Write the value as text to `w`, or throw the error that stopped it.
	fn format[W: Writer](self, inout w: W) throws(os.Error)
}

impl Format for str {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try w.write_bytes(self.bytes())
	}
}

impl Format for bool {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		if self {
			try w.write_bytes("true".bytes())
		} else {
			try w.write_bytes("false".bytes())
		}
	}
}

impl Format for u8 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_decimal(&w, u64(self), false)
	}
}

impl Format for u16 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_decimal(&w, u64(self), false)
	}
}

impl Format for u32 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_decimal(&w, u64(self), false)
	}
}

impl Format for u64 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_decimal(&w, self, false)
	}
}

impl Format for usize {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_decimal(&w, u64(self), false)
	}
}

impl Format for i8 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_signed(&w, i64(self))
	}
}

impl Format for i16 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_signed(&w, i64(self))
	}
}

impl Format for i32 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_signed(&w, i64(self))
	}
}

impl Format for i64 {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_signed(&w, self)
	}
}

impl Format for isize {
	fn format[W: Writer](self, inout w: W) throws(os.Error) {
		try write_signed(&w, i64(self))
	}
}

/// Write `n` in decimal to `w`, with a `-` if it's negative.
fn write_signed[W: Writer](inout w: W, n: i64) throws(os.Error) {
	if n < 0 {
		try write_decimal(&w, magnitude(n), true)
		return
	}
	try write_decimal(&w, u64(n), false)
}

/// The absolute value of `n`. `-n` overflows for the smallest `i64`, so a
/// negative `n` goes through `n + 1`, which can be negated.
fn magnitude(n: i64) -> u64 {
	if n < 0 {
		return u64(-(n + 1)) + 1
	}
	return u64(n)
}

/// Write `n` in decimal to `w`, after a `-` if `negative`, in one
/// `write_bytes`.
///
/// The digits go into a buffer from the end, and element 0 is kept for the
/// sign. 20 digits hold the largest `u64`, so the loop always ends when `v`
/// is 0; `i <= 1` is what proves there's room (the checker doesn't count
/// digits), and it leaves `i >= 1` for the sign. The output is the slice
/// `digits[i..]`.
///
/// This is a plain array rather than a `buf.StackBuf[21]`: with one, every
/// program printing an integer was 640 bytes larger at -O2 (`push_front`
/// isn't inlined, its thrown error goes through memory, and the written
/// part is checked again before the write).
fn write_decimal[W: Writer](inout w: W, n: u64, negative: bool) throws(os.Error) {
	var digits: [21]u8 = [0; 21]
	var i = digits.len - 1
	var v = n
	loop {
		digits[i] = '0' + u8(v % 10)
		v = v / 10
		if v == 0 {
			break
		}
		if i <= 1 {
			break
		}
		i = i - 1
	}
	if negative {
		i = i - 1
		digits[i] = '-'
	}
	try w.write_bytes(digits[i..])
}

/// A piece of a format string: text written as it is, or an argument.
enum Piece {
	/// The bytes `start..end` of the format string.
	text(start: usize, end: usize)
	/// Argument number `index`.
	arg(index: usize)
}

/// What's wrong with a format string, and where: byte offsets in it.
enum FormatError {
	/// The `{` at `at` isn't closed.
	unclosed(at: usize)
	/// The `}` at `at` closes nothing.
	unmatched(at: usize)
	/// The placeholder `at..end` isn't `{}`.
	spec(at: usize, end: usize)
	/// The `{}` at `at` has no argument: there are `placeholders` of them
	/// for `given` arguments.
	missing(at: usize, placeholders: usize, given: usize)
	/// There are `placeholders` placeholders for more arguments, `given`.
	unused(placeholders: usize, given: usize)
}

/// A piece of a format string, and the offset where the next one starts.
struct Next {
	piece: Piece
	end: usize
}

/// The piece of the format string `b` at `at`, the next placeholder being
/// argument `arg`: `none` at the end. Text runs up to a brace; `{{` and
/// `}}` end a piece of text with one brace.
fn next_piece(b: []u8, at: usize, arg: usize) throws(FormatError) -> ?Next {
	if at >= b.len {
		return none
	}
	let doubled = at + 1 < b.len && b[at + 1] == b[at]
	if b[at] == '{' && !doubled {
		var i = at + 1
		while i < b.len {
			if b[i] == '}' {
				if i == at + 1 {
					return Next{piece: .arg(arg), end: i + 1}
				}
				throw .spec(at, i + 1)
			}
			if b[i] == '{' {
				break
			}
			i += 1
		}
		throw .unclosed(at)
	}
	if b[at] == '}' && !doubled {
		throw .unmatched(at)
	}
	var i = at
	while i < b.len {
		if b[i] == '{' || b[i] == '}' {
			if i + 1 < b.len && b[i + 1] == b[i] {
				return Next{piece: .text(at, i + 1), end: i + 2}
			}
			break
		}
		i += 1
	}
	return Next{piece: .text(at, i), end: i}
}

/// The number of pieces of the format string `fmt`, checked for `given`
/// arguments: each `{}` has one, and each argument a `{}`.
fn format_pieces(fmt: str, given: usize) throws(FormatError) -> usize {
	let b = fmt.bytes()
	var at: usize = 0
	var pieces: usize = 0
	var placeholders: usize = 0
	var missing: ?usize = none
	loop {
		let found = try next_piece(b, at, placeholders)
		let next = found else {
			break
		}
		if next.piece == .arg(placeholders) {
			if placeholders >= given && missing == none {
				missing = at
			}
			placeholders +|= 1
		}
		pieces +|= 1
		at = next.end
	}
	if let at = missing {
		throw .missing(at, placeholders, given)
	}
	if placeholders < given {
		throw .unused(placeholders, given)
	}
	return pieces
}

/// Piece `k` of the format string `fmt`, which `format_pieces` checked.
fn format_piece(fmt: str, k: usize) -> Piece {
	let b = fmt.bytes()
	var at: usize = 0
	var arg: usize = 0
	var n: usize = 0
	loop {
		let found = next_piece(b, at, arg) catch _ {
			break
		}
		let next = found else {
			break
		}
		if n == k {
			return next.piece
		}
		if next.piece == .arg(arg) {
			arg +|= 1
		}
		n +|= 1
		at = next.end
	}
	return .text(0, 0)
}

/// "placeholder" or "placeholders", for `n` of them.
fn placeholder_noun(n: usize) -> str {
	if n == 1 {
		return "placeholder"
	}
	return "placeholders"
}

/// "argument" or "arguments", for `n` of them.
fn argument_noun(n: usize) -> str {
	if n == 1 {
		return "argument"
	}
	return "arguments"
}
